rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    // manager_credentials: Dedicated Manager Credentials table for isolated auth
    match /manager_credentials/{docId} {
      allow read, write: if true;
    }

    // trainer_credentials: Dedicated Trainer & Trainee Credentials table for isolated auth
    match /trainer_credentials/{docId} {
      allow read, write: if true;
    }

    // user_credentials: Legacy compatibility credentials table
    match /user_credentials/{docId} {
      allow read, write: if true;
    }

    // users: User Profile document records
    match /users/{userId} {
      allow read, write: if true;
    }

    // teams: Department and Team definitions
    match /teams/{teamId} {
      allow read, write: if true;
    }

    // dailyUpdates: End-of-day reports & daily logs
    match /dailyUpdates/{updateId} {
      allow read, write: if true;
    }

    // classes: Active, scheduled, and past batch classes
    match /classes/{classId} {
      allow read, write: if true;
    }

    // tasks: Assigned trainer and trainee tasks
    match /tasks/{taskId} {
      allow read, write: if true;
    }

    // projects: Student milestones and project tracking
    match /projects/{projectId} {
      allow read, write: if true;
    }

    // system_config: Enterprise security passcodes and system parameters
    match /system_config/{configId} {
      allow read, write: if true;
    }

    // manager_change_requests: Formal manager change requests between instructors and managers
    match /manager_change_requests/{requestId} {
      allow read, write: if true;
    }

    // Fallback match for any supplementary application documents
    match /{document=**} {
      allow read, write: if true;
    }
  }
}

